datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  MEMBER
  CLIENT
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum ClientStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectBillingType {
  ONE_TIME
  MILESTONE_BASED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MilestoneApprovalStatus {
  PENDING
  APPROVED
  REVISION_REQUESTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PAID
  OVERDUE
  CANCELLED
}

enum SubscriptionPlan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  TRIALING
}

enum PaymentMethod {
  STRIPE
  MANUAL
  BANK_TRANSFER
  CASH
  OTHER
}

enum RecurringInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  passwordHash            String
  firstName               String
  lastName                String
  avatarUrl               String?
  phone                   String?
  emailVerified           Boolean                  @default(false)
  failedLoginAttempts     Int                      @default(0)
  lockedUntil             DateTime?
  googleAccessToken       String?
  googleRefreshToken      String?
  googleTokenExpiry       DateTime?
  googleEmail             String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  memberships             Membership[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  activityLogs            ActivityLog[]
  clients                 Client[]                 // User linked to client portal
  chatParticipants        ChatParticipant[]
  chatMessages            ChatMessage[]
  chatReceipts            ChatMessageReceipt[]
  meetingsCreated         Meeting[]                @relation("MeetingCreator")
  meetingAttendees        MeetingAttendee[]
  tasksCreated            Task[]                   @relation("TaskCreator")
  tasksAssigned           Task[]                   @relation("TaskAssignee")

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("email_verification_tokens")
}

model WebhookEvent {
  id            String   @id @default(uuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([stripeEventId])
  @@map("webhook_events")
}

model Organization {
  id                String         @id @default(uuid())
  name              String
  slug              String         @unique
  logoUrl           String?
  currency          String         @default("USD")
  defaultTaxRate    Decimal        @default(0) @db.Decimal(5, 2)
  invoicePrefix     String         @default("INV-")
  nextInvoiceNumber Int            @default(1)
  googleAccessToken  String?
  googleRefreshToken String?
  googleTokenExpiry  DateTime?
  googleEmail        String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  memberships       Membership[]
  invites           Invite[]
  clients           Client[]
  projects          Project[]
  invoices          Invoice[]
  payments          Payment[]
  subscription      Subscription?
  activityLogs      ActivityLog[]
  chatRooms         ChatRoom[]
  meetings          Meeting[]
  projectFiles      ProjectFile[]
  milestones        Milestone[]
  tasks             Task[]

  @@map("organizations")
}

model Membership {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           Role         @default(MEMBER)
  projectId      String?      // Optional assigned project for MEMBER role
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([projectId])
  @@map("memberships")
}

model Invite {
  id             String       @id @default(uuid())
  organizationId String
  email          String
  name           String?
  phone          String?
  role           Role         @default(MEMBER)
  projectId      String?      // Optional assigned project for invited member
  tokenHash      String       @unique
  expiresAt      DateTime
  status         InviteStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
  @@index([tokenHash])
  @@index([projectId])
  @@map("invites")
}

model Client {
  id             String            @id @default(uuid())
  organizationId String
  userId         String?           // Optional link to a User with CLIENT role for the portal
  name           String
  email          String
  company        String?
  address        String?
  phone          String?
  notes          String?
  status         ClientStatus      @default(ACTIVE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  projects         Project[]
  invoices         Invoice[]
  meetingAttendees MeetingAttendee[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@map("clients")
}

model Project {
  id             String        @id @default(uuid())
  organizationId String
  clientId       String
  name           String
  description    String?
  status         ProjectStatus      @default(ACTIVE)
  billingType    ProjectBillingType @default(ONE_TIME)
  budget         Decimal?           @db.Decimal(12, 2)
  deadline       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoices       Invoice[]
  meetings       Meeting[]
  chatRooms      ChatRoom[]
  memberships    Membership[]
  invites        Invite[]
  files          ProjectFile[]
  milestones     Milestone[]
  tasks          Task[]

  @@index([organizationId])
  @@index([clientId])
  @@map("projects")
}

model ProjectFile {
  id             String       @id @default(uuid())
  projectId      String
  organizationId String
  fileName       String
  fileUrl        String
  fileType       String       // 'pdf' | 'word'
  fileSize       Int          // in bytes
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([organizationId])
  @@map("project_files")
}

model Milestone {
  id             String                  @id @default(uuid())
  projectId      String
  organizationId String
  title          String
  description    String?
  budget         Decimal?                @db.Decimal(12, 2)
  deadline       DateTime?
  status         MilestoneStatus         @default(PENDING)
  approvalStatus MilestoneApprovalStatus @default(PENDING)
  revisionNotes  String?
  revisionCount  Int                     @default(0)
  approvedAt     DateTime?
  order          Int                     @default(0)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  project        Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([organizationId])
  @@index([status])
  @@index([approvalStatus])
  @@map("milestones")
}

model Task {
  id             String       @id @default(uuid())
  organizationId String
  projectId      String
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?
  estimatedHours Float?
  order          Int          @default(0)
  aiGenerated    Boolean      @default(false)
  createdById    String?
  assigneeId     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([projectId])
  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@map("tasks")
}

model Invoice {
  id                 String             @id @default(uuid())
  organizationId     String
  clientId           String
  projectId          String?
  number             String
  status             InvoiceStatus      @default(DRAFT)
  subtotal           Decimal            @default(0) @db.Decimal(12, 2)
  taxRate            Decimal            @default(0) @db.Decimal(5, 2)
  tax                Decimal            @default(0) @db.Decimal(12, 2)
  discount           Decimal            @default(0) @db.Decimal(12, 2)
  total              Decimal            @default(0) @db.Decimal(12, 2)
  currency           String             @default("USD")
  clientName         String?
  clientEmail        String?
  clientAddress      String?
  issueDate          DateTime           @default(now())
  dueDate            DateTime
  notes              String?
  terms              String?
  sentAt             DateTime?
  lastResentAt       DateTime?
  dailyResendCount   Int                @default(0)
  dailyResendResetAt DateTime?
  emailFailedAt      DateTime?
  emailError         String?
  viewedAt           DateTime?
  paidAt             DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  isRecurring        Boolean            @default(false)
  recurringInterval  RecurringInterval?
  nextRecurringDate  DateTime?
  nextRunAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client             Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project            Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items              InvoiceItem[]
  payments           Payment[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  qty         Decimal  @default(1) @db.Decimal(10, 2)
  rate        Decimal  @default(0) @db.Decimal(12, 2)
  amount      Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id               String        @id @default(uuid())
  organizationId   String
  invoiceId        String
  amount           Decimal       @db.Decimal(12, 2)
  method           PaymentMethod @default(STRIPE)
  stripePaymentId  String?       @unique
  stripeReceiptUrl String?
  paidAt           DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice          Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([invoiceId])
  @@map("payments")
}

model Subscription {
  id                   String             @id @default(uuid())
  organizationId       String             @unique
  plan                 SubscriptionPlan   @default(FREE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model RefreshToken {
  id                 String    @id @default(uuid())
  userId             String
  tokenHash          String    @unique
  family             String
  expiresAt          DateTime
  revokedAt          DateTime?
  replacedByTokenId  String?
  userAgent          String?
  ip                 String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([family])
  @@map("refresh_tokens")
}

model ActivityLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  entity         String
  entityId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

enum ChatRoomType {
  DIRECT
  GROUP
}

model ChatRoom {
  id             String            @id @default(uuid())
  organizationId String
  projectId      String?
  type           ChatRoomType      @default(DIRECT)
  name           String?
  description    String?
  avatarUrl      String?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  participants   ChatParticipant[]
  messages       ChatMessage[]

  @@index([organizationId])
  @@index([projectId])
  @@map("chat_rooms")
}

model ChatParticipant {
  id         String    @id @default(uuid())
  roomId     String
  userId     String
  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())

  room       ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
  @@index([roomId])
  @@map("chat_participants")
}

model ChatMessage {
  id             String               @id @default(uuid())
  roomId         String
  senderId       String
  type           String               @default("text") // "text" | "meeting" | "system"
  meetingId      String?
  content        String?
  attachmentUrl  String?
  attachmentName String?
  attachmentType String?
  attachmentSize Int?
  isDeleted      Boolean              @default(false)
  deletedAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  room           ChatRoom             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender         User                 @relation(fields: [senderId], references: [id], onDelete: Cascade)
  meeting        Meeting?             @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  receipts       ChatMessageReceipt[]

  @@index([roomId])
  @@index([senderId])
  @@index([meetingId])
  @@index([createdAt])
  @@map("chat_messages")
}

model ChatMessageReceipt {
  id        String      @id @default(uuid())
  messageId String
  userId    String
  readAt    DateTime    @default(now())

  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@index([messageId])
  @@map("chat_message_receipts")
}

model Meeting {
  id            String            @id @default(uuid())
  companyId     String
  projectId     String
  title         String
  type          String            @default("instant") // "instant" | "scheduled"
  provider      String            @default("jaas")
  roomName      String            @unique
  meetLink      String?
  startTime     DateTime          @default(now())
  endTime       DateTime?
  status        String            @default("live") // "scheduled" | "live" | "ended" | "cancelled"
  googleEventId String?
  createdById   String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  company       Organization      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy     User              @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: Cascade)
  attendees     MeetingAttendee[]
  chatMessages  ChatMessage[]

  @@index([companyId])
  @@index([projectId])
  @@index([createdById])
  @@index([status])
  @@map("meetings")
}

model MeetingAttendee {
  id        String   @id @default(uuid())
  meetingId String
  userId    String?
  clientId  String?
  email     String
  role      String   @default("team") // "host" | "team" | "client"
  createdAt DateTime @default(now())

  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([meetingId, email])
  @@index([meetingId])
  @@index([userId])
  @@index([clientId])
  @@map("meeting_attendees")
}

