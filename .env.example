# Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
POSTGRES_PASSWORD=postgres_dev_password
DATABASE_URL=postgresql://postgres:postgres_dev_password@localhost:5432/cliently_dev?schema=public

# Redis (BullMQ & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_secret
REDIS_URL=redis://:redis_dev_secret@localhost:6379

# Internal Health Check Security
HEALTH_TOKEN=dev_health_secret_token_12345

# JWT Authentication
JWT_ACCESS_SECRET=super-secret-access-token-key-cliently-12345
JWT_REFRESH_SECRET=super-secret-refresh-token-key-cliently-67890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP / MailHog (Local Email Testing)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=no-reply@cliently.local

# Stripe (Test Mode)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRO_PRICE_ID=price_placeholder

# JaaS (Jitsi as a Service)
JAAS_APP_ID=
JAAS_KEY_ID=
JAAS_PRIVATE_KEY=

# Gemini AI (Task Generation from Requirements)
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth & Service Account (Calendar & Meetings)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# App Config
APP_NAME=Cliently
